# ==========================================
# EMPÓRIO DA MÚSICA - AI AGENT CONFIGURATION
# ==========================================

# Active LLM Provider: 'groq' (default, high speed), 'openai', or 'ollama'
LLM_PROVIDER=groq

# ------------------------------------------
# Provider 1: Groq (Recommended for low latency)
# ------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1

# ------------------------------------------
# Provider 2: OpenAI
# ------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# ------------------------------------------
# Provider 3: Ollama (Local open-source models)
# ------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ------------------------------------------
# System & Persistence Settings
# ------------------------------------------
DATABASE_PATH=emporio_records.db
LOG_LEVEL=INFO
DEFAULT_SESSION_ID=emp-session-dev
